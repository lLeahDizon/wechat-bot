[Unit]
Description=Sub2API IP model routing proxy
After=network.target docker.service

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/sub2api-ip-model-router
ExecStart=/opt/sub2api-ip-model-router/venv/bin/python -B router.py --config /opt/sub2api-ip-model-router/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
